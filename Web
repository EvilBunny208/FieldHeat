/* ---------- Practice tools ---------- */
function peakDuring(model,W,s,e){
  let peak=-Infinity,at=s;
  for(let t=s;t<=e;t+=15*MIN){const f=C2F(predict(model,weatherAt(W,t)));if(f>peak){peak=f;at=t}}
  return {peak,at};
}
function bestWindow(model,W,now,durH){
  let best=null;
  for(let s=Math.ceil(now/(30*MIN))*30*MIN;s<=now+30*HOUR;s+=30*MIN){
    const d=new Date(s),h=d.getHours()+d.getMinutes()/60;
    if(h<6||h+durH>21)continue;
    const p=peakDuring(model,W,s,s+durH*HOUR);
    if(!best||p.peak<best.peak-0.05)best={s,e:s+durH*HOUR,...p};
  }
  return best;
}
function planTimes(){
  const [hh,mm]=($("#plan-start").value||"15:30").split(":").map(Number);
  const dur=parseFloat($("#plan-dur").value)||2;
  const d=new Date();d.setHours(hh,mm,0,0);
  let s=d.getTime();if(s+dur*HOUR<Date.now())s+=24*HOUR;
  return {s,e:s+dur*HOUR,dur};
}

