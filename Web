function hourlyLog(readings){
  const start=new Date();start.setHours(0,0,0,0);
  const rows=[];
  for(let t=start.getTime();t<=Date.now();t+=HOUR){
    let best=null,bd=Infinity;
    for(let i=readings.length-1;i>=0;i--){const d=Math.abs(readings[i].t-t);if(d<bd){bd=d;best=readings[i]}if(readings[i].t<t-HOUR)break}
    if(best&&bd<=10*MIN)rows.push({t,r:best});
  }
  return rows;
}
