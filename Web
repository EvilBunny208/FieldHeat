function renderChart(){
  const {readings,model,W,now,nowF}=state;
  const box=$("#chart"),Wd=Math.max(280,box.clientWidth||520),H=240;
  const L=38,R=10,T=10,B=26,x0=now-6*HOUR,x1=now+6*HOUR;
  const past=readings.filter(r=>r.t>=x0&&r.t<=now).map(r=>({t:r.t,f:C2F(r.w)}));
  const hind=[],fut=[{t:now,f:nowF,err:0}];
  for(let t=x0;t<=now;t+=15*MIN)hind.push({t,f:C2F(predict(model,weatherAt(W,t)))});
  for(let t=now+15*MIN;t<=x1;t+=15*MIN){const ha=(t-now)/HOUR;fut.push({t,f:C2F(predict(model,weatherAt(W,t))),err:errAt(model,ha)})}
  const vals=past.map(p=>p.f).concat(hind.map(p=>p.f),fut.map(p=>p.f+p.err),fut.map(p=>p.f-p.err));
  let lo=Math.floor(Math.min(...vals,80)-1),hi=Math.ceil(Math.max(...vals,84)+1);
  if(hi-lo<12){const m=(hi+lo)/2;lo=Math.floor(m-6);hi=Math.ceil(m+6)}
  const X=t=>L+(t-x0)/(x1-x0)*(Wd-L-R),Y=f=>T+(hi-Math.min(hi,Math.max(lo,f)))/(hi-lo)*(H-T-B);
  const path=pts=>pts.map((p,i)=>(i?"L":"M")+X(p.t).toFixed(1)+" "+Y(p.f).toFixed(1)).join("");
  let s='<svg viewBox="0 0 '+Wd+" "+H+'" role="img" aria-label="WBGT for the last 6 hours and AI forecast for the next 6 hours">';
  const edges=[lo,82,87,90,92,hi];
  for(let i=0;i<5;i++){const a=Math.max(lo,edges[i]),b=Math.min(hi,edges[i+1]);if(b>a)s+='<rect class="band b'+i+'" x="'+L+'" y="'+Y(b)+'" width="'+(Wd-L-R)+'" height="'+(Y(a)-Y(b))+'"/>'}
  for(let f=Math.ceil(lo/5)*5;f<=hi;f+=5)s+='<line class="grid" x1="'+L+'" x2="'+(Wd-R)+'" y1="'+Y(f)+'" y2="'+Y(f)+'"/><text class="ax" x="'+(L-6)+'" y="'+(Y(f)+4)+'" text-anchor="end">'+f+'°</text>';
  for(let t=Math.ceil(x0/(3*HOUR))*3*HOUR;t<=x1;t+=3*HOUR)s+='<text class="ax" x="'+X(t)+'" y="'+(H-6)+'" text-anchor="middle">'+fmtHour(t)+"</text>";
  const up=fut.map(p=>({t:p.t,f:p.f+p.err})),dn=fut.map(p=>({t:p.t,f:p.f-p.err})).reverse();
  s+='<path class="ribbon" d="'+path(up)+path(dn).replace(/^M/,"L")+'Z"/>';
  s+='<path class="l-hind" d="'+path(hind)+'"/>';
  const step=Math.max(1,Math.floor(past.length/240));
  const pts=past.filter((_,i)=>i%step===0||i===past.length-1);
  if(pts.length>1)s+='<path class="l-sensor" d="'+path(pts)+'"/>';
  s+='<path class="l-fc" d="'+path(fut)+'"/>';
  s+='<line class="now" x1="'+X(now)+'" x2="'+X(now)+'" y1="'+T+'" y2="'+(H-B)+'"/><text class="ax" x="'+(X(now)+4)+'" y="'+(T+12)+'">Now</text></svg>';
  box.innerHTML=s;
}
