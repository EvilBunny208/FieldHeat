<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FieldHeat</title>
<meta name="description" content="Live heat-stress (WBGT) monitor, AI forecast and practice planner for high school fields.">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="FieldHeat">
<meta name="theme-color" content="#12261b">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'%3E%3Crect width='120' height='120' rx='26' fill='%2312261B'/%3E%3Cg transform='translate(12 10) scale(0.8)'%3E%3Cpath d='M44 34 C38 28, 50 22, 44 14' fill='none' stroke='%23F0A35E' stroke-width='7' stroke-linecap='round'/%3E%3Cpath d='M60 32 C54 24, 66 16, 60 6' fill='none' stroke='%23F0A35E' stroke-width='7' stroke-linecap='round'/%3E%3Cpath d='M76 34 C70 28, 82 22, 76 14' fill='none' stroke='%23F0A35E' stroke-width='7' stroke-linecap='round'/%3E%3Ccircle cx='60' cy='68' r='27' fill='%230A1710' stroke='%23F4F6F1' stroke-width='4'/%3E%3Crect x='8' y='102' width='104' height='8' rx='4' fill='%233AA660'/%3E%3C/g%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap">
<style>
/* Layout: one phone-width column. Status, AI forecast, practice tools, chart, model, sensor, log, settings. */
:root{
  --bg:#eef2ec; --surface:#ffffff; --ink:#16201a; --muted:#56655b; --line:#d6ddd5;
  --accent:#1d6b45; --accent-soft:#dcebe1;
  --g:#23774a; --y:#e5b50f; --o:#c9560f; --r:#b92b26; --k:#141414;
  --heat:#b04a0e; --globe:#12261b; --globe-ring:#12261b;
  --font-display:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;
  --font-body:"Barlow",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1411; --surface:#161e19; --ink:#e6ece7; --muted:#9aa89f; --line:#27322b;
  --accent:#6fc493; --accent-soft:#1c2e23;
  --g:#2b8a55; --y:#e5b50f; --o:#d2621b; --r:#c9362f; --k:#050505;
  --heat:#f0a35e; --globe:#0a1710; --globe-ring:#f4f6f1; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e1411; --surface:#161e19; --ink:#e6ece7; --muted:#9aa89f; --line:#27322b;
  --accent:#6fc493; --accent-soft:#1c2e23;
  --g:#2b8a55; --y:#e5b50f; --o:#d2621b; --r:#c9362f; --k:#050505;
  --heat:#f0a35e; --globe:#0a1710; --globe-ring:#f4f6f1; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 var(--font-body);
  padding-block:20px 40px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
main{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:22px}
h1,h2,h3{font-family:var(--font-display);font-weight:600;margin:0;text-wrap:balance}
h2{font-size:15px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
h3{font-size:22px;line-height:1.1}
.top{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap}
.brand h1{font-size:30px;line-height:1;letter-spacing:.01em}
.brand h1 span{color:var(--heat)}
.logo{display:flex;align-items:center;gap:10px}
.logo .wave{fill:none;stroke:var(--heat);stroke-width:7;stroke-linecap:round}
.logo .globe{fill:var(--globe);stroke:var(--globe-ring);stroke-width:3}
.logo .post{fill:var(--globe-ring)}
.logo .turf{fill:var(--g)}
.brand p{margin:4px 0 0;color:var(--muted);font-size:14px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:999px;border:1px solid var(--line);color:var(--muted);background:var(--surface)}
.chip.live{color:var(--accent);border-color:var(--accent)}
.chip.sample{color:var(--ink);border-color:var(--y)}
.chip.ai{color:var(--accent);background:var(--accent-soft);border-color:transparent}
.status{--band-bg:var(--g);--band-fg:#fff;background:var(--band-bg);color:var(--band-fg);border-radius:18px;padding:20px 20px 18px;display:flex;flex-direction:column;gap:10px}
.status[data-band="1"]{--band-bg:var(--y);--band-fg:#2a2000}
.status[data-band="2"]{--band-bg:var(--o)}
.status[data-band="3"]{--band-bg:var(--r)}
.status[data-band="4"]{--band-bg:var(--k);border:1px solid var(--line)}
.status .flag{font-family:var(--font-display);font-size:20px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.reading{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.big{font-family:var(--font-display);font-weight:700;font-size:clamp(72px,22vw,120px);line-height:.9;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.unit{font-family:var(--font-display);font-size:22px;font-weight:600;opacity:.9}
.source{font-size:14px;opacity:.9}
.rules{margin:4px 0 0;padding-left:20px;display:flex;flex-direction:column;gap:2px;font-size:15px}
.alert{border-radius:12px;padding:12px 14px;border:1px solid var(--line);background:var(--surface);display:flex;gap:10px;align-items:flex-start}
.alert .dot{flex:none;width:12px;height:12px;border-radius:50%;margin-top:6px;background:var(--o)}
.alert.cool .dot{background:var(--g)}
.alert strong{display:block}
.alert p{margin:0;font-size:15px}
section{display:flex;flex-direction:column;gap:10px}
.sec-head{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px}
.fc{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.fc .cell{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:4px}
.fc .time{font-size:13px;color:var(--muted)}
.fc .val{font-family:var(--font-display);font-size:34px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
.fc .range{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.pill{align-self:flex-start;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:999px;color:#fff;background:var(--g)}
.pill[data-band="1"]{background:var(--y);color:#2a2000}
.pill[data-band="2"]{background:var(--o)}
.pill[data-band="3"]{background:var(--r)}
.pill[data-band="4"]{background:var(--k)}
.strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(52px,1fr);gap:6px;overflow-x:auto;padding-bottom:4px}
.hr{display:flex;flex-direction:column;align-items:center;gap:4px;font-variant-numeric:tabular-nums}
.hr .t{font-size:12px;color:var(--muted);white-space:nowrap}
.hr .v{font-family:var(--font-display);font-size:20px;font-weight:600;line-height:1}
.hr .bar{width:100%;height:6px;border-radius:3px;background:var(--g)}
.hr .bar[data-band="1"]{background:var(--y)}.hr .bar[data-band="2"]{background:var(--o)}.hr .bar[data-band="3"]{background:var(--r)}.hr .bar[data-band="4"]{background:var(--k);outline:1px solid var(--line)}
.conf{font-size:13px;color:var(--muted);margin:0}
.window{display:flex;flex-direction:column;gap:6px}
.window .when{font-family:var(--font-display);font-size:30px;font-weight:600;line-height:1.05}
.window p{margin:0;font-size:15px}
.plan form{margin-top:0}
.plan-out{display:flex;flex-direction:column;gap:8px;margin-top:4px}
.verdict{border-radius:10px;padding:10px 12px;font-weight:600;font-size:15px;background:var(--accent-soft);color:var(--ink)}
.verdict.bad{background:var(--r);color:#fff}
.verdict.warn{background:var(--y);color:#2a2000}
.plan-out ul{margin:0;padding-left:20px;font-size:15px;display:flex;flex-direction:column;gap:3px}
.chart-wrap{width:100%}
.chart-wrap svg{display:block;width:100%;height:auto}
.ax{fill:var(--muted);font:12px var(--font-body)}
.grid{stroke:var(--line);stroke-width:1}
.b0{fill:var(--g)}.b1{fill:var(--y)}.b2{fill:var(--o)}.b3{fill:var(--r)}.b4{fill:var(--k)}
.band{opacity:.14}
.ribbon{fill:var(--accent);opacity:.18}
.l-sensor{fill:none;stroke:var(--ink);stroke-width:2;stroke-linejoin:round}
.l-hind{fill:none;stroke:var(--accent);stroke-width:1.5;stroke-dasharray:1 4;stroke-linecap:round}
.l-fc{fill:none;stroke:var(--accent);stroke-width:2.5;stroke-dasharray:6 5}
.now{stroke:var(--muted);stroke-dasharray:3 4}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:18px;height:0;border-top:2px solid var(--ink);vertical-align:middle;margin-right:6px}
.legend i.fc{border-top:2.5px dashed var(--accent)}
.legend i.hind{border-top:2px dotted var(--accent)}
.legend i.rib{height:10px;border:0;background:var(--accent);opacity:.25}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.stat{display:flex;flex-direction:column}
.stat span{font-size:13px;color:var(--muted)}
.stat b{font-family:var(--font-display);font-size:26px;font-weight:600;font-variant-numeric:tabular-nums}
.model{display:flex;flex-direction:column;gap:10px}
.model p{margin:0;font-size:15px}
.duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.duo div{border:1px solid var(--line);border-radius:10px;padding:10px}
.duo span{display:block;font-size:13px;color:var(--muted)}
.duo b{font-family:var(--font-display);font-size:28px;font-weight:600;font-variant-numeric:tabular-nums}
.duo .win b{color:var(--accent)}
.learned{margin:0;padding-left:20px;font-size:15px;display:flex;flex-direction:column;gap:3px}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14px;font-variant-numeric:tabular-nums}
th,td{text-align:right;padding:7px 6px;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left}
th{font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}
td .pill{display:inline-block}
textarea{width:100%;min-height:120px;font:13px/1.4 ui-monospace,Menlo,Consolas,monospace;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px;margin-top:8px}
details summary{cursor:pointer;font-weight:600;padding:4px 0}
form{display:grid;gap:12px;margin-top:12px}
label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--muted)}
input[type=text],input[type=password],input[type=number],input[type=time],select{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 10px;width:100%;min-width:0}
.row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.check{flex-direction:row;align-items:center;gap:8px;color:var(--ink)}
.btns{display:flex;gap:10px;flex-wrap:wrap}
button{font:600 15px var(--font-body);border-radius:10px;padding:10px 16px;border:1px solid var(--accent);background:var(--accent);color:var(--surface);cursor:pointer}
button.ghost{background:transparent;color:var(--accent)}
button.small{padding:6px 12px;font-size:14px}
button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.error{color:var(--r);font-size:14px;margin:0}
footer{font-size:13px;color:var(--muted);line-height:1.5}
@media (prefers-reduced-motion:no-preference){.status{transition:background-color .4s}}
</style>
</head>
<body>
<main>
  <header class="top">
    <div class="brand">
      <div class="logo">
        <svg width="40" height="40" viewBox="0 0 120 120" aria-hidden="true">
          <path class="wave" d="M44 34 C38 28, 50 22, 44 14"/><path class="wave" d="M60 32 C54 24, 66 16, 60 6"/><path class="wave" d="M76 34 C70 28, 82 22, 76 14"/>
          <circle class="globe" cx="60" cy="68" r="27"/><rect class="post" x="57" y="95" width="6" height="7"/><rect class="turf" x="8" y="102" width="104" height="7" rx="3.5"/>
        </svg>
        <h1>Field<span>Heat</span></h1>
      </div>
      <p id="place">Fort Myers, FL</p>
    </div>
    <div class="chips"><span class="chip" id="mode">Loading</span><span class="chip" id="updated">—</span></div>
  </header>

  <div class="status" id="status" data-band="0" aria-live="polite">
    <div class="flag" id="flag">Loading</div>
    <div class="reading"><span class="big" id="big">--</span><span class="unit">°F WBGT</span></div>
    <div class="source" id="source">Reading the field…</div>
    <ul class="rules" id="rules"></ul>
  </div>

  <div class="alert" id="alert" hidden><span class="dot"></span><div><strong id="alert-title"></strong><p id="alert-text"></p></div></div>
  <p class="error" id="error" hidden></p>

  <section>
    <div class="sec-head"><h2>AI forecast</h2><span class="chip ai" id="ai-chip">Field model</span></div>
    <div class="fc" id="fc"></div>
    <div class="card">
      <div class="strip" id="strip"></div>
      <p class="conf" id="conf"></p>
    </div>
  </section>

  <section>
    <h2>Best time to practice</h2>
    <div class="card window" id="window"><p>Finding the coolest window…</p></div>
  </section>

  <section class="plan">
    <h2>Practice planner</h2>
    <div class="card">
      <form id="plan-form">
        <div class="row2">
          <label for="plan-start">Start time<input type="time" id="plan-start" value="15:30"></label>
          <label for="plan-dur">Length
            <select id="plan-dur">
              <option value="1">1 hour</option><option value="1.5">1.5 hours</option><option value="2" selected>2 hours</option>
              <option value="2.5">2.5 hours</option><option value="3">3 hours</option>
            </select>
          </label>
        </div>
      </form>
      <div class="plan-out" id="plan-out"></div>
    </div>
  </section>

  <section>
    <h2>Last 6 hours, next 6 hours</h2>
    <div class="card">
      <div class="chart-wrap" id="chart"></div>
      <div class="legend"><span><i></i>Field sensor</span><span><i class="hind"></i>AI model on past hours</span><span><i class="fc"></i>AI forecast</span><span><i class="rib"></i>Likely range</span></div>
    </div>
  </section>

  <section>
    <h2>What the AI learned about this field</h2>
    <div class="card model" id="model"><p>Training…</p></div>
  </section>

  <section>
    <h2>Sensor</h2>
    <div class="card stats">
      <div class="stat"><span>Air temperature</span><b id="s-ta">--</b></div>
      <div class="stat"><span>Humidity</span><b id="s-rh">--</b></div>
      <div class="stat"><span>Black globe</span><b id="s-tg">--</b></div>
      <div class="stat"><span>Wind (forecast)</span><b id="s-v">--</b></div>
    </div>
  </section>

  <section>
    <div class="sec-head"><h2>Today's hourly heat log</h2><button type="button" class="ghost small" id="copy-log">Copy log</button></div>
    <div class="card table-wrap">
      <table><thead><tr><th>Hour</th><th>Air °F</th><th>RH %</th><th>WBGT °F</th><th>Level</th></tr></thead><tbody id="log"></tbody></table>
      <textarea id="log-text" readonly hidden aria-label="Heat log text"></textarea>
    </div>
  </section>

  <section>
    <details class="card" id="settings">
      <summary>Settings</summary>
      <form id="cfg-form">
        <label for="cfg-url">Supabase project URL<input type="text" id="cfg-url" placeholder="https://yourproject.supabase.co" autocomplete="off"></label>
        <label for="cfg-key">Supabase anon key<input type="password" id="cfg-key" autocomplete="off"></label>
        <div class="row2">
          <label for="cfg-device">Device ID<input type="text" id="cfg-device"></label>
          <label for="cfg-diam">Globe diameter (in)<input type="number" id="cfg-diam" step="0.5" min="2" max="8"></label>
        </div>
        <label for="cfg-place">Field name<input type="text" id="cfg-place"></label>
        <div class="row2">
          <label for="cfg-lat">Latitude<input type="number" id="cfg-lat" step="0.0001"></label>
          <label for="cfg-lon">Longitude<input type="number" id="cfg-lon" step="0.0001"></label>
        </div>
        <label class="check" for="cfg-demo"><input type="checkbox" id="cfg-demo"> Show sample data instead of the sensor</label>
        <div class="btns"><button type="submit">Save and refresh</button><button type="button" class="ghost" id="refresh">Refresh now</button></div>
      </form>
    </details>
  </section>

  <footer>Activity guidance follows the FHSAA WBGT activity guidelines required under Florida's Zachary Martin Act. FieldHeat supports, and does not replace, the school's certified WBGT device and athletic trainer.</footer>
</main>

<script>
"use strict";
const $=s=>document.querySelector(s);
const C2F=c=>c*9/5+32;
const SIGMA=5.67e-8;
const HOUR=3600e3,MIN=60e3;

const BANDS=[
  {name:"Green · Normal activity",short:"Green",limit:Infinity,breaks:"3 rest breaks of 3 minutes",rules:["Normal practice","At least 3 rest breaks per hour, 3 minutes each"]},
  {name:"Yellow · Use caution",short:"Yellow",limit:Infinity,breaks:"3 rest breaks of 4 minutes",rules:["Use discretion for intense or long sessions","Watch at-risk athletes closely","At least 3 rest breaks per hour, 4 minutes each"]},
  {name:"Orange · 2-hour limit",short:"Orange",limit:2,breaks:"4 rest breaks of 4 minutes",rules:["Practice limited to 2 hours","Football: helmet, shoulder pads and shorts only","No equipment during conditioning","At least 4 rest breaks per hour, 4 minutes each"]},
  {name:"Red · 1-hour limit",short:"Red",limit:1,breaks:"20 minutes of rest",rules:["Practice limited to 1 hour","No protective equipment and no conditioning","20 minutes of rest within the hour"]},
  {name:"Black · No outdoor activity",short:"Black",limit:0,breaks:"no outdoor activity",rules:["No outdoor workouts","Delay practice until WBGT drops"]}
];
function band(f){return f<82?0:f<87?1:f<=90?2:f<92?3:4}

/* ---------- Heat-stress physics ---------- */
function stull(ta,rh){
  rh=Math.min(99,Math.max(5,rh));
  return ta*Math.atan(0.151977*Math.sqrt(rh+8.313659))+Math.atan(ta+rh)-Math.atan(rh-1.676331)
    +0.00391838*Math.pow(rh,1.5)*Math.atan(0.023101*rh)-4.686035;
}
function mrt(tg,ta,v,d,eps=0.95){
  v=Math.max(v,0.1);
  const x=Math.pow(tg+273.15,4)+1.1e8*Math.pow(v,0.6)/(eps*Math.pow(d,0.4))*(tg-ta);
  return Math.pow(Math.max(x,1),0.25)-273.15;
}
function globe6(tg,ta,v,dFrom){
  const target=mrt(tg,ta,v,dFrom);
  let lo=ta-20,hi=ta+60;
  for(let i=0;i<60;i++){const m=(lo+hi)/2;if(mrt(m,ta,v,0.150)<target)lo=m;else hi=m}
  return (lo+hi)/2;
}
function wbgt(ta,rh,tg6){return 0.7*stull(ta,rh)+0.2*tg6+0.1*ta}
function globeEstimate(ta,sr,v){
  v=Math.max(v,0.1);
  const h=6.3*Math.pow(v,0.6)/Math.pow(0.15,0.4);
  const q=0.95*Math.max(sr,0)*0.3;
  const K=t=>t+273.15;
  let lo=ta,hi=ta+45;
  for(let i=0;i<50;i++){const m=(lo+hi)/2;const loss=0.95*SIGMA*(K(m)**4-K(ta)**4)+h*(m-ta);if(loss<q)lo=m;else hi=m}
  return (lo+hi)/2;
}
function baseline(w){return wbgt(w.ta,w.rh,globeEstimate(w.ta,w.sr,w.v))}

/* ---------- AI field model: ridge regression on the gap between this field and the weather forecast ---------- */
const feat=w=>[1,w.sr/1000,w.v/5,(w.rh-70)/30];
const dot=(a,b)=>a.reduce((s,x,i)=>s+x*b[i],0);
function solve(A,b){
  const n=b.length,M=A.map((r,i)=>[...r,b[i]]);
  for(let c=0;c<n;c++){
    let p=c;for(let r=c+1;r<n;r++)if(Math.abs(M[r][c])>Math.abs(M[p][c]))p=r;
    [M[c],M[p]]=[M[p],M[c]];
    const d=M[c][c]||1e-9;
    for(let r=0;r<n;r++){if(r===c)continue;const f=M[r][c]/d;for(let k=c;k<=n;k++)M[r][k]-=f*M[c][k]}
  }
  return M.map((r,i)=>r[n]/(r[i]||1e-9));
}
function fitRidge(X,y,lam){
  const p=X[0].length,A=Array.from({length:p},()=>Array(p).fill(0)),b=Array(p).fill(0);
  X.forEach((r,i)=>{for(let j=0;j<p;j++){b[j]+=r[j]*y[i];for(let k=0;k<p;k++)A[j][k]+=r[j]*r[k]}});
  for(let j=1;j<p;j++)A[j][j]+=lam;
  return solve(A,b);
}
function fitAny(X,y){
  if(y.length>=8)return fitRidge(X,y,0.5);
  if(y.length>=1)return [y.reduce((a,b)=>a+b,0)/y.length,0,0,0];
  return [0,0,0,0];
}
function trainModel(readings,W){
  const buckets=new Map();
  for(const r of readings){const k=Math.round(r.t/HOUR)*HOUR;if(!buckets.has(k))buckets.set(k,[]);buckets.get(k).push(r.w)}
  const X=[],y=[],first=W.t[0],last=W.t[W.t.length-1];
  for(const [k,ws] of buckets){
    if(ws.length<3||k<first||k>last)continue;
    const w=weatherAt(W,k),mean=ws.reduce((a,b)=>a+b,0)/ws.length;
    X.push(feat(w));y.push(mean-baseline(w));
  }
  const n=y.length,coef=fitAny(X,y);
  let mae=null,baseErr=null;
  if(n>=3){
    let s=0;
    for(let i=0;i<n;i++){const c=fitAny(X.filter((_,j)=>j!==i),y.filter((_,j)=>j!==i));s+=Math.abs(dot(c,X[i])-y[i])}
    mae=s/n*1.8;
    baseErr=y.reduce((a,b)=>a+Math.abs(b),0)/n*1.8;
  }
  return {n,coef,mae,baseErr};
}
function predict(model,w){return baseline(w)+dot(model.coef,feat(w))}
function errAt(model,hoursAhead){return (model.mae??2.5)*(1+0.08*hoursAhead)}

/* ---------- Weather (Open-Meteo) ---------- */
function clean(a){let last=null;const out=a.map(v=>{if(v==null)return last;last=v;return v});let next=null;for(let i=out.length-1;i>=0;i--){if(out[i]==null)out[i]=next??0;else next=out[i]}return out}
async function fetchWeather(c){
  const u="https://api.open-meteo.com/v1/forecast?latitude="+c.lat+"&longitude="+c.lon+
    "&hourly=temperature_2m,relative_humidity_2m,wind_speed_10m,shortwave_radiation&wind_speed_unit=ms&timezone=GMT&past_days=3&forecast_days=3";
  const r=await fetch(u);if(!r.ok)throw new Error("Weather service returned "+r.status);
  const h=(await r.json()).hourly;
  return {live:true,t:h.time.map(s=>Date.parse(s+":00Z")),ta:clean(h.temperature_2m),rh:clean(h.relative_humidity_2m),w10:clean(h.wind_speed_10m),sr:clean(h.shortwave_radiation)};
}
function synthWeather(){
  const W={live:false,t:[],ta:[],rh:[],w10:[],sr:[]};
  const start=Math.floor(Date.now()/HOUR)*HOUR-72*HOUR;
  for(let t=start;t<=start+144*HOUR;t+=HOUR){
    const h=new Date(t).getHours(),s=Math.sin((h-9)/24*2*Math.PI);
    W.t.push(t);W.ta.push(26+5*s);W.rh.push(75-15*s);W.w10.push(3);
    W.sr.push(h>7&&h<=19?850*Math.sin((h-7)/12*Math.PI):0);
  }
  return W;
}
function weatherAt(W,t){
  const interp=(k,tt)=>{
    const n=W.t.length;let i;
    if(tt<=W.t[0])i=0;else if(tt>=W.t[n-1])i=n-2;else{let lo=0,hi=n-1;while(hi-lo>1){const m=(lo+hi)>>1;if(W.t[m]<=tt)lo=m;else hi=m}i=lo}
    const f=Math.min(1,Math.max(0,(tt-W.t[i])/(W.t[i+1]-W.t[i])));
    return W[k][i]+(W[k][i+1]-W[k][i])*f;
  };
  /* Radiation is an hourly mean ending on the hour, so read it half an hour later. */
  return {ta:interp("ta",t),rh:interp("rh",t),sr:Math.max(0,interp("sr",t+HOUR/2)),v:0.7*interp("w10",t)};
}

/* ---------- Sensor data (Supabase) ---------- */
async function loadSensor(c){
  const base=c.url.replace(/\/+$/,"");
  const since=new Date(Date.now()-72*HOUR).toISOString();
  let all=[];
  for(let off=0;off<5000;off+=1000){
    const q=base+"/rest/v1/readings?select=created_at,ta,rh,tg&device_id=eq."+encodeURIComponent(c.device)+
      "&created_at=gte."+encodeURIComponent(since)+"&order=created_at.desc&limit=1000&offset="+off;
    const r=await fetch(q,{headers:{apikey:c.key,Authorization:"Bearer "+c.key}});
    if(!r.ok)throw new Error("Supabase returned "+r.status+". Check the URL, key and table policies.");
    const rows=await r.json();all=all.concat(rows);
    if(rows.length<1000)break;
  }
  return all.map(x=>({t:Date.parse(x.created_at),ta:+x.ta,rh:+x.rh,tg:+x.tg}))
    .filter(x=>isFinite(x.t)&&isFinite(x.ta)&&isFinite(x.rh)&&isFinite(x.tg)).sort((a,b)=>a.t-b.t);
}
function noise(t,k){const x=Math.sin(t/60000*12.9898+k*78.233)*43758.5453;return x-Math.floor(x)-0.5}
function sampleReadings(W){
  const out=[],end=Math.floor(Date.now()/300000)*300000;
  for(let t=end-48*HOUR;t<=end;t+=300000){
    const w=weatherAt(W,t);
    const ta=w.ta+0.5*w.sr/800+0.3*noise(t,1);
    const rh=Math.min(99,Math.max(20,w.rh-1+1.5*noise(t,2)));
    const g=globeEstimate(ta,w.sr*1.08,w.v);
    out.push({t,ta,rh,tg:ta+(g-ta)*0.88+0.3*noise(t,3)});
  }
  return out;
}

