async function refresh(){
  const c=loadCfg();fillForm(c);
  $("#place").textContent=c.place;
  const err=$("#error");err.hidden=true;
  let W;try{W=await fetchWeather(c)}catch(e){W=synthWeather()}
  let readings=[],sample=c.demo||!c.url||!c.key;
  if(!sample){
    try{readings=await loadSensor(c)}catch(e){err.textContent="Couldn't reach your sensor: "+e.message+" Showing sample data.";err.hidden=false;sample=true}
  }
  if(sample)readings=sampleReadings(W);
  for(const r of readings){const v=weatherAt(W,r.t).v;r.tg6=globe6(r.tg,r.ta,v,c.diam*0.0254);r.w=wbgt(r.ta,r.rh,r.tg6)}
  const model=trainModel(readings,W),now=Date.now();
  const latest=readings[readings.length-1];
  const fresh=latest&&now-latest.t<20*MIN;
  const nowF=C2F(fresh?latest.w:predict(model,weatherAt(W,now)));
  const hourly=[];
  for(let h=1;h<=12;h++){const t=Math.ceil(now/HOUR)*HOUR+(h-1)*HOUR;hourly.push({t,f:C2F(predict(model,weatherAt(W,t))),err:errAt(model,(t-now)/HOUR)})}
  state={readings,model,W,now,nowF,logText:""};
  renderStatus(nowF,fresh?"Field sensor · "+fmtTime(latest.t):"AI estimate · sensor has no reading in the last 20 minutes");
  renderAlert(nowF,hourly);renderForecast(hourly,model);renderWindow();renderPlan();renderChart();
  renderModel(model);renderSensor(fresh?latest:null,weatherAt(W,now));renderLog(readings);
  $("#mode").textContent=sample?"Sample data":"Live sensor";$("#mode").className="chip "+(sample?"sample":"live");
  $("#updated").textContent="Updated "+fmtTime(now)+(W.live?"":" · forecast offline");
}
let rt;window.addEventListener("resize",()=>{clearTimeout(rt);rt=setTimeout(()=>{if(state)renderChart()},150)});
refresh();setInterval(refresh,60e3);
</script>
